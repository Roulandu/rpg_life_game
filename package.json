{
  "name": "rpg-life-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "android:sync": "npm run build:native && cap sync android",
    "android:open": "cap open android",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "validate:data": "tsx scripts/validate-data.ts",
    "docs:build": "tsx scripts/quality/generate-module-docs.ts",
    "docs:check": "tsx scripts/quality/generate-module-docs.ts --check",
    "quality:tech-debt": "tsx scripts/quality/check-tech-debt.ts",
    "quality:duplication": "tsx scripts/quality/check-duplication.ts",
    "quality:boundaries": "tsx scripts/quality/check-boundaries.ts",
    "quality:test-impact": "tsx scripts/quality/check-test-impact.ts",
    "quality:doc-sync": "tsx scripts/quality/check-doc-sync.ts",
    "quality:coverage": "tsx scripts/quality/check-coverage.ts",
    "quality:anti-regression": "tsx scripts/quality/check-anti-regression.ts",
    "quality:baseline": "tsx scripts/quality/check-baseline.ts",
    "quality:staged": "tsx scripts/quality/check-staged.ts",
    "quality:commit-msg": "tsx scripts/quality/check-commit-msg.ts",
    "quality:commit-range": "tsx scripts/quality/check-commit-range.ts",
    "quality:update": "tsx scripts/quality/update-baseline.ts",
    "quality:report": "tsx scripts/quality/report.ts",
    "quality:file": "tsx scripts/quality/inspect-file.ts",
    "check:tech-debt": "npm run quality:tech-debt",
    "check:duplication": "npm run quality:duplication",
    "check:boundaries": "npm run quality:boundaries",
    "check:test-impact": "npm run quality:test-impact",
    "check:doc-sync": "npm run quality:doc-sync",
    "check:coverage": "npm run quality:coverage",
    "check:anti-regression": "npm run quality:anti-regression",
    "check:baseline": "npm run quality:baseline",
    "check:staged": "npm run quality:staged",
    "check:commit-msg": "npm run quality:commit-msg",
    "check:commit-range": "npm run quality:commit-range",
    "hooks:install": "tsx scripts/install-hooks.ts",
    "check:fast": "npm run typecheck && npm run lint && npm run validate:data && npm run quality:tech-debt && npm run quality:boundaries",
    "check": "npm run check:fast && npm run quality:duplication && npm run quality:test-impact && npm run quality:doc-sync && npm run test:coverage && npm run quality:coverage && npm run quality:anti-regression && npm run quality:baseline && npm run quality:commit-range && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "immer": "^11.2.9",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "es-module-lexer": "^2.3.2",
    "fake-indexeddb": "^6.2.6",
    "jscpd": "^4.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
