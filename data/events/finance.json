[
  {
    "id": "fn_first_statement",
    "title": "第一份对账单",
    "body": "银行寄来的月度对账单上，税那一栏第一次超过了你的周薪。客服说这是正常代扣，建议你「找专业人士看一次」。",
    "sender": "银行",
    "weight": 4,
    "expiresDays": 5,
    "cooldownDays": 40,
    "maxPerSeason": 2,
    "blocking": false,
    "guaranteed": false,
    "when": [{ "field": "balance", "op": "gte", "value": 200000 }],
    "choices": [
      {
        "id": "advisor",
        "label": "付钱请一次税务咨询",
        "description": "花掉一小笔，换一张能看懂的表。",
        "effects": [{ "op": "money", "delta": -300 }, { "op": "confidence", "delta": 2 }, { "op": "morale", "delta": 1 }]
      },
      {
        "id": "ignore",
        "label": "先放着不管",
        "description": "反正钱是自动扣的。",
        "effects": [{ "op": "morale", "delta": -2 }, { "op": "familyTrust", "delta": -1 }]
      }
    ],
    "resultTexts": {
      "advisor": "咨询结束时你第一次知道，自己每场球的税后到手是多少。",
      "ignore": "三个月后同一封信变成了催缴，金额比当初那笔税还大。"
    }
  },
  {
    "id": "fn_agent_deal",
    "title": "经纪人的新合同",
    "body": "经纪人把续约条款推到你面前：佣金从 5% 涨到 8%，但对方承诺下周带来一份地区代言。他补了一句，不签也没关系。",
    "sender": "经纪人",
    "weight": 3,
    "expiresDays": 4,
    "cooldownDays": 60,
    "maxPerSeason": 2,
    "blocking": true,
    "guaranteed": false,
    "when": [
      { "field": "agentTrust", "op": "gte", "value": 45 },
      { "field": "seasonProgress", "op": "gte", "value": 0.2 }
    ],
    "choices": [
      {
        "id": "sign",
        "label": "签下来换代言机会",
        "description": "佣金高，但事情有人在跑。",
        "effects": [{ "op": "money", "delta": 1200 }, { "op": "agentTrust", "delta": 3 }, { "op": "mediaRep", "delta": 2 }]
      },
      {
        "id": "negotiate",
        "label": "把佣金压回 5%，代言不签",
        "description": "他会有点不高兴。",
        "effects": [{ "op": "agentTrust", "delta": -2 }, { "op": "confidence", "delta": 3 }, { "op": "money", "delta": 60 }]
      },
      {
        "id": "wait",
        "label": "说要看几天",
        "description": "把主动权留在手里。",
        "effects": [{ "op": "morale", "delta": 1 }, { "op": "agentTrust", "delta": -1 }]
      }
    ],
    "resultTexts": {
      "sign": "代言签得不大，但那是你第一个有人主动来找你签字的下午。",
      "negotiate": "他改了条款，速度慢了两周，你才意识到佣金差的那 3% 是真的。",
      "wait": "四天以后他带来的是另一个人的签约消息。"
    }
  },
  {
    "id": "fn_family_request",
    "title": "家里的第一个明确的请求",
    "body": "父亲第一次在电话里说清楚要多少：翻修屋顶，折下来大约是你两个月的工资。他说完就后悔了，开始说「其实也没那么急」。",
    "sender": "家人",
    "weight": 3,
    "expiresDays": 6,
    "cooldownDays": 70,
    "once": true,
    "blocking": true,
    "guaranteed": false,
    "when": [{ "field": "balance", "op": "gte", "value": 400000 }],
    "choices": [
      {
        "id": "pay_all",
        "label": "全额汇过去",
        "description": "他们会觉得这钱来得容易。",
        "effects": [{ "op": "money", "delta": -2000 }, { "op": "familyTrust", "delta": 6 }, { "op": "morale", "delta": 2 }]
      },
      {
        "id": "half_plan",
        "label": "先付一半并说明余下的计划",
        "description": "把钱和界限一起讲清楚。",
        "effects": [{ "op": "money", "delta": -1000 }, { "op": "familyTrust", "delta": 3 }, { "op": "confidence", "delta": 2 }]
      },
      {
        "id": "loan",
        "label": "以借款方式记账",
        "description": "冷，但没有人会误解。",
        "effects": [{ "op": "money", "delta": -2000 }, { "op": "familyTrust", "delta": -3 }, { "op": "confidence", "delta": 1 }]
      }
    ],
    "resultTexts": {
      "pay_all": "屋顶换完那天他们拍了照片，照片里没有人看镜头。",
      "half_plan": "父亲过了两周才回话，说剩下的他自己解决了。",
      "loan": "钱到了，借条也被收下了，之后每次通话都短了一分钟。"
    }
  },
  {
    "id": "fn_teammate_loan",
    "title": "队友的借款",
    "body": "{teammate}在停车场拦住你，说要借一笔不大但对他很大的钱，下周工资到账就还。他说这话时没有看你。",
    "sender": "队友",
    "weight": 3,
    "expiresDays": 2,
    "cooldownDays": 45,
    "maxPerSeason": 2,
    "blocking": true,
    "guaranteed": false,
    "when": [
      { "field": "teammateTrust", "op": "gte", "value": 50 },
      { "field": "balance", "op": "gte", "value": 300000 }
    ],
    "choices": [
      {
        "id": "lend",
        "label": "借，不提还的时间",
        "description": "更衣室会知道这件事。",
        "effects": [{ "op": "money", "delta": -600 }, { "op": "teammateTrust", "delta": 5 }, { "op": "morale", "delta": 1 }]
      },
      {
        "id": "half_gift",
        "label": "给一半，另一半说是送的",
        "description": "少一点尴尬，也少一点回收。",
        "effects": [{ "op": "money", "delta": -300 }, { "op": "teammateTrust", "delta": 3 }, { "op": "confidence", "delta": 1 }]
      },
      {
        "id": "refuse",
        "label": "说不方便",
        "description": "边界清楚，代价是关系。",
        "effects": [{ "op": "teammateTrust", "delta": -4 }, { "op": "morale", "delta": -1 }]
      }
    ],
    "resultTexts": {
      "lend": "他没在下周还，但在赛季最后一场给你让了队长手套的位置。",
      "half_gift": "那三百块他后来硬塞回给你，多给了五十。",
      "refuse": "第二天的传球练习里，他找别人配合了。"
    }
  },
  {
    "id": "fn_sponsor_advance",
    "title": "赞助商的预付",
    "body": "一家你没听过的品牌愿意预付三个月的推广费，条件是你把合同里的一条改写成「可代为发布训练内容」，配图由他们决定。",
    "sender": "赞助商",
    "weight": 3,
    "expiresDays": 4,
    "cooldownDays": 35,
    "blocking": false,
    "guaranteed": false,
    "when": [
      { "field": "clubTier", "op": "lte", "value": 2 },
      { "field": "mediaRep", "op": "gte", "value": 30 }
    ],
    "choices": [
      {
        "id": "take",
